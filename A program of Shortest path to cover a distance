import java.util.*;
class Direction
{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the directions from the starting point");
        String str=sc.next();
        int i=0,x=0,y=0;
        while(i<str.length())
        {
            char c=str.charAt(i);
            if(c=='N')
            y++;
             if(c=='S')
            y--;
             if(c=='E')
            x++;
             if(c=='W')
            x--;
            i++;
            
        }
        double d=Math.sqrt(x*x+y*y);
        System.out.println("Shortest distance = "+d);
    }
}
