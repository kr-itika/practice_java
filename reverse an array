
class Main {
    Scanner sc=new Scanner(System.in);
    public static void main(String[] args) {
        int num[]={7,9,3,6,99,56,35};
        int n=num.length;
        int mid=n/2;
        int m=n-1;
          for(int i=0;i<=mid;i++)
          {
              int t=num[m-i];
              num[m-i]=num[i];
              num[i]=t;
          }
         for(int i=0;i<n;i++)
          {
              System.out.print(num[i] +"  " );
          }
        
    }
}
