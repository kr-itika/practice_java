class Main 
{
    public static void main(String[] args) {
        int num[]={7,9,3,6,99,56,35};
        int n=num.length;
        int start=0,end=1;
        while(start<n-1)
        {
            if(end<n)
            {
            System.out.print("("+num[start]+","+num[end]+") ");
            end++;
            }
            else
            {
                start++;
                end=start+1;
                System.out.println();
            }
            
        }
    }  
}
