M1: Checking through String 
class Solution {
    public boolean isPalindrome(int x) {
        String str=String.valueOf(x);
        StringBuilder sb=new StringBuilder(str);
        sb.reverse();
        String rev=sb.toString();  //as sb is not a variable its an object so convert into variable to check with str a variable
        if(rev.equals(str))
        return true;
        else
        return false;
    }
}


